{
  "name": "dsh-workflow-presets",
  "version": "1.0.0",
  "type": "module",
  "description": "Per-session workflow presets for DeepSeek Harness: skill catalog tiers, global tool gating, persona, permission packs and prompt templates.",
  "license": "MIT",
  "author": "patrickb46-hub",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patrickb46-hub/dsh-workflows.git"
  },
  "homepage": "https://github.com/patrickb46-hub/dsh-workflows#readme",
  "bugs": {
    "url": "https://github.com/patrickb46-hub/dsh-workflows/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workflow",
    "preset",
    "skills",
    "prompt"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
